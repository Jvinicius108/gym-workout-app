rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ FUNÇÃO DO ADMIN: Verifica o UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'Y5WAFq09SZfYoA0kz0Uk5Q71o8p1';
    }

    // ✅ REGRA MÁGICA: Admin pode ler e escrever em QUALQUER lugar
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ✅ REGRAS PARA USUÁRIOS COMUNS
    match /users/{userId} {
      
      // 🛡️ BLOQUEAR MASS ASSIGNMENT: Permite edição, mas REJEITA se o hacker tentar injetar 
      // campos falsos para ganhar poderes (ex: isAdmin, planoPremium, etc).
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId
                            && !request.resource.data.keys().hasAny(['isAdmin', 'role', 'isPremium']);
      
      // Subcoleção: feitos (Histórico)
      match /feitos/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcoleção: fotos (🛡️ RESTRINGIR UPLOADS)
      match /fotos/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        
        // Permite gravar a foto, mas se você souber o nome exato do campo onde o Base64 é salvo 
        // (ex: 'fotoData'), você pode impedir strings gigantes que travam o banco.
        // allow create, update: if request.auth != null && request.auth.uid == userId 
        //                       && request.resource.data.fotoData.size() < 800000; 
        allow create, update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ✅ LEITURA DE SUBSTITUTOS E FOTOS GLOBAIS (qualquer um logado)
    match /global_substitutes/{docId} {
      allow read: if request.auth != null;
    }
    match /global_fotos/{docId} {
      allow read: if request.auth != null;
    }

    // ✅ USUÁRIOS PODEM ABRIR CHAMADOS
    match /chamados/{ticketId} {
      // 🛡️ SEGURANÇA EXTRA: Impede que um usuário abra um chamado se passando por outro.
      // Ele só pode criar se o campo 'uid' dentro do chamado for igual ao UID de quem está logado.
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid;
    }
  }
}